// The UI, which runs in the browser. svelte-check does the checking, because
// tsc alone does not read .svelte: `npm run check`.
{
  "extends": ["@tsconfig/svelte/tsconfig.json", "./tsconfig.base.json"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // What the UI uses from the platform, like Array.findLast. The syntax that
    // comes out of the build is decided by `build.target` in vite.config.ts.
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
