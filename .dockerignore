# Inverted logic: nothing enters the build context except what is explicitly
# allowed below. That way a new file at the repository root - a credential, a
# dump, a binary - stays out by default, without relying on someone
# remembering to add it here.
**

# Go module: copied on their own in the Dockerfile so the dependency layer only
# rebuilds when the dependencies change.
!go.mod
!go.sum

# Go code that the build compiles.
!cmd/**
!internal/**

# UI source. npm ci and npm run build happen inside the image.
!web/**

# ...but the UI dependencies are installed in there by npm ci; sending the
# local node_modules would only bloat the context (and bring binaries of the
# wrong architecture).
web/node_modules/**
