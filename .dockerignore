# O build da interface acontece dentro da imagem
web/node_modules/

# Configuração e dados locais nunca entram na imagem
dwnvr.yaml
cameras.json
.session-secret
.env

# Os dois volumes que o docker-compose.yml monta ao lado do clone
/config/
/storage/

# Binários locais
/dwnvr
/dwnvr-*

# Coisas que não afetam o build
.git/
docs/
*.md
