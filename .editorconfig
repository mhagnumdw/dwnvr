# File formatting, so the editor does not fight what is already in the repo.
# It only describes what is true today of every versioned file: UTF-8, LF,
# a final newline and no trailing whitespace.
#
# Reference: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt indents with tabs and the matter is not up for debate. indent_size here
# does not change the file: it only says how many columns wide the editor
# should draw the tab.
[*.{go,mod,sum}]
indent_style = tab
indent_size = 4

# make requires a tab at the start of a recipe line - spaces are a syntax error.
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

# The UI build, generated by vite and versioned (see web/README.md). Nothing
# here is edited by hand, so the editor must not reformat it.
[internal/api/dist/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Generated by npm.
[web/package-lock.json]
indent_style = unset
indent_size = unset
