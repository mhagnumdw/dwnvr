# Configuration of the developer machine. Copy it to local.mk, which is not
# versioned:
#
#     cp local.mk.example local.mk
#
# The Makefile includes it on its own when it exists, so `make deploy` and
# `make deploy-wip` work without arguments. Passing the variable on the command
# line still works and takes precedence over what is here.

# Server where dwnvr runs as a container. Without this, both deploys stop with
# a message instead of trying an ssh to nowhere.
DEPLOY_HOST ?= usuario@servidor

# The dwnvr clone on the server, where docker-compose.yml comes from. The
# Makefile default is already this one.
DEPLOY_DIR  ?= ~/dwnvr
