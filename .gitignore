# Configuração do teste rápido, quando o docker-compose.yml lê ao lado do
# clone: a do dwnvr (senhas em hash, fotos, segredo da sessão) e a do go2rtc
# (URLs RTSP com usuário e senha). A pasta inteira, e não arquivo por arquivo,
# para pegar também o que o dwnvr passar a gravar ali. Com a barra, para não
# pegar o internal/config.
/config/

# Configuração de build da máquina de quem desenvolve (ver local.mk.example)
local.mk

# Personalizações do docker-compose.yml versionado ficam fora do versionamento.
docker-compose.override.yml

# Gravações, quando o docker-compose.yml grava ao lado do clone
/storage/

.env

# Binários
/dwnvr
/dwnvr-*
# ... menos o detector de objetos, que é código e casa com o padrão acima
!/dwnvr-detect/
# O fp32 que o dwnvr-detect/modelo/exporta.py gera no caminho: ~100 MB, e
# qualquer um o refaz a partir dos pesos públicos.
/dwnvr-detect/modelo/*_fp32.onnx

# Frontend
web/node_modules/

# Claude
.claude/worktrees/
.claude/settings.local.json
.claude/RESUME.md

# Bytecode do Python, do dwnvr-detect.
__pycache__/
