# Quick-test configuration, when docker-compose.yml reads it next to the clone:
# dwnvr's (hashed passwords, photos, session secret) and go2rtc's (RTSP URLs
# with user and password). The whole folder, not file by file, so it also
# catches whatever dwnvr starts writing there. With the leading slash, so it
# does not catch internal/config.
/config/

# Build configuration of the developer machine (see local.mk.example)
local.mk

# Customizations of the versioned docker-compose.yml stay out of version
# control.
docker-compose.override.yml

# Recordings, when docker-compose.yml writes next to the clone
/storage/

.env

# Binaries
/dwnvr
/dwnvr-*
# ... except the object detector, which is code and matches the pattern above
!/dwnvr-detect/
# The fp32 that dwnvr-detect/model/export.py generates along the way: ~100 MB,
# and anyone can regenerate it from the public weights.
/dwnvr-detect/model/*_fp32.onnx

# Frontend
web/node_modules/

# Claude
.claude/worktrees/
.claude/settings.local.json
.claude/RESUME.md

# Python bytecode, from dwnvr-detect.
__pycache__/
