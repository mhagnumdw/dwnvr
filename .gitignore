# Configuração local da instalação (contém credenciais do go2rtc)
dwnvr.yaml
cameras.json
.session-secret

# Configuração local do go2rtc. Versionado só o .example: o arquivo real leva
# as URLs RTSP das câmeras, com usuário e senha embutidos.
go2rtc.yaml

# Configuração de build da máquina de quem desenvolve (ver local.mk.example)
local.mk

# Personalizações do docker-compose.yml versionado ficam fora do versionamento.
docker-compose.override.yml

# Gravações, quando o docker-compose.yml grava ao lado do clone
/storage/

.env

# Binários
/dwnvr
/dwnvr-*
# ... menos o detector de objetos, que é código e casa com o padrão acima
!/dwnvr-detect/
# O fp32 que o dwnvr-detect/modelo/exporta.py gera no caminho: ~100 MB, e
# qualquer um o refaz a partir dos pesos públicos.
/dwnvr-detect/modelo/*_fp32.onnx

# Frontend
web/node_modules/

# Claude
.claude/worktrees/
.claude/settings.local.json
.claude/RESUME.md

# Bytecode do Python, do dwnvr-detect.
__pycache__/
